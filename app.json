{
  "expo": {
    "name": "Training Mind",
    "slug": "memory-games",
    "scheme": "memorygames",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/memory-games-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gokalpelacmaz.memorygames2026",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.gokalpelacmaz.memorygames2026",
      "adaptiveIcon": {
        "backgroundColor": "#0E1220",
        "foregroundImage": "./assets/memory-games-icon-android.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/memory-games-favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58b89b85-b9dc-4128-a2e5-71d2b69af140"
      }
    }
  }
}
